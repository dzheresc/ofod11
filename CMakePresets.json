{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed"
      }
    },
    { "name": "gcc", "hidden": true, "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++-13" } },
    { "name": "clang", "hidden": true, "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++-18" } },

    { "name": "gcc-debug", "inherits": "gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "gcc-release", "inherits": "gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "OFOD_WARNINGS_AS_ERRORS": "ON" } },
    { "name": "clang-debug", "inherits": "clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "clang-release", "inherits": "clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "OFOD_WARNINGS_AS_ERRORS": "ON" } },
    { "name": "clang-asan", "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all"
      } },
    { "name": "clang-tsan", "inherits": "clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_CXX_FLAGS": "-fsanitize=thread" } },
    { "name": "profile", "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -fno-omit-frame-pointer -DNDEBUG",
        "OFOD_BUILD_BENCH": "ON",
        "VCPKG_MANIFEST_FEATURES": "bench"
      } },
    { "name": "profile-native", "inherits": "profile",
      "cacheVariables": { "CMAKE_CXX_FLAGS": "-march=native" } },
    { "name": "compare", "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OFOD_BUILD_TESTS": "OFF",
        "OFOD_BUILD_CHAPTERS": "OFF",
        "OFOD_BUILD_COMPARE": "ON",
        "VCPKG_MANIFEST_FEATURES": "compare",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed_compare"
      } },
    { "name": "coverage", "inherits": "gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_FLAGS": "--coverage" } }
  ],
  "buildPresets": [
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "clang-asan", "configurePreset": "clang-asan" },
    { "name": "clang-tsan", "configurePreset": "clang-tsan" },
    { "name": "profile", "configurePreset": "profile" },
    { "name": "profile-native", "configurePreset": "profile-native" },
    { "name": "compare", "configurePreset": "compare" },
    { "name": "coverage", "configurePreset": "coverage" }
  ],
  "testPresets": [
    { "name": "gcc-debug", "configurePreset": "gcc-debug", "output": { "outputOnFailure": true } },
    { "name": "gcc-release", "configurePreset": "gcc-release", "output": { "outputOnFailure": true } },
    { "name": "clang-debug", "configurePreset": "clang-debug", "output": { "outputOnFailure": true } },
    { "name": "clang-release", "configurePreset": "clang-release", "output": { "outputOnFailure": true } },
    { "name": "clang-asan", "configurePreset": "clang-asan", "output": { "outputOnFailure": true } },
    { "name": "clang-tsan", "configurePreset": "clang-tsan", "output": { "outputOnFailure": true } }
  ]
}
